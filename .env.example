# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).

# ---- Local dev against Neon (current setup) ----
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# PORT=3000
# DATABASE_SSL is unset -> SSL ON (Neon requires it)

# ---- Docker Compose on the Pi ----
# docker-compose.yml reads THIS file for the values below.
# The api container gets DATABASE_URL/DATABASE_SSL from compose, not from here.
POSTGRES_PASSWORD=choose-a-strong-db-password
JWT_SECRET=change-me-to-a-long-random-string
#   generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROBOFLOW_API_KEY=your-roboflow-api-key
# SAM_ENDPOINT_URL=https://your-sam-service/refine

# DATABASE_SSL=disable  -> for a local/self-hosted Postgres with no TLS (the Pi).
#                          Leave unset for Neon/Render.
