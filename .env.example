# Copy this file to .env and fill in real values. NEVER commit .env.
# (.env is gitignored; this .example file is safe to commit.)

# Postgres connection string (Neon now, the Pi's local Postgres later).
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Port the server listens on. Render sets this automatically; locally any port.
PORT=3000

# Roboflow serverless API key (hold detection).
ROBOFLOW_API_KEY=your-roboflow-api-key

# Secret used to sign JWT auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional: URL of the SAM refinement service. Leave unset to skip SAM
# (detection falls back to Roboflow polygons).
# SAM_ENDPOINT_URL=https://your-sam-service/refine
